# ---- Mobile app (public values only; copy to .env.local) -------------------
# Your Supabase project URL and its PUBLISHABLE (anon) key. These are safe to ship.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# ---- Edge Function secrets (NEVER put these in the app or in EXPO_PUBLIC_*) --
# Set with:  supabase secrets set --env-file supabase/.env.secrets
# ANTHROPIC_API_KEY=...
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5-5
# AI_LIMIT_PER_MINUTE=12
# AI_LIMIT_PER_DAY=150
# AI_LIMIT_GLOBAL_PER_DAY=5000
